{
  "configure": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operation_id",
      "expected_livemode",
      "expected_revision",
      "reminders"
    ],
    "properties": {
      "operation_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "expected_livemode": {
        "type": "boolean"
      },
      "expected_revision": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "reminders": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "when", "duration", "periodicity"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "type": {
              "type": "string",
              "enum": [
                "default",
                "daily",
                "weekly",
                "monthly",
                "yearly",
                "custom"
              ]
            },
            "when": {
              "type": "string",
              "enum": ["before", "after"]
            },
            "duration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            "periodicity": {
              "type": "string",
              "enum": ["day", "week", "month", "year"]
            },
            "custom_subject": {
              "type": "string",
              "nullable": true,
              "maxLength": 300
            },
            "custom_template": {
              "type": "string",
              "nullable": true,
              "maxLength": 10000
            }
          }
        }
      },
      "limitDaysToPay": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3650
      }
    }
  },
  "recovery_prepare": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operation_id",
      "expected_livemode",
      "expected_revision",
      "reminders",
      "supersedes_operation_id",
      "affected_generations"
    ],
    "properties": {
      "operation_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "expected_livemode": {
        "type": "boolean"
      },
      "expected_revision": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "reminders": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "when", "duration", "periodicity"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "type": {
              "type": "string",
              "enum": [
                "default",
                "daily",
                "weekly",
                "monthly",
                "yearly",
                "custom"
              ]
            },
            "when": {
              "type": "string",
              "enum": ["before", "after"]
            },
            "duration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            "periodicity": {
              "type": "string",
              "enum": ["day", "week", "month", "year"]
            },
            "custom_subject": {
              "type": "string",
              "nullable": true,
              "maxLength": 300
            },
            "custom_template": {
              "type": "string",
              "nullable": true,
              "maxLength": 10000
            }
          }
        }
      },
      "limitDaysToPay": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3650
      },
      "supersedes_operation_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "affected_generations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reminder_id", "generation"],
          "properties": {
            "reminder_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "generation": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
